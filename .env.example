# Default provider: Google AI Studio (free tier, no credit card). Get a key at https://aistudio.google.com/apikey
PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# Free-tier Flash model name; check AI Studio for the current one
MODEL=gemini-3.6-flash
# Seconds between calls (6 s = 10 requests/minute, safe for the free tier)
MIN_INTERVAL_S=6

# Alternative (paid): PROVIDER=anthropic and ANTHROPIC_API_KEY=...
